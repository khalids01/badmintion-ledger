{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Badminton Ledger",
  "version": "1.2.0",
  "identifier": "com.badmintonledger.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Badminton Ledger",
        "width": 1360,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://wjrlgcvyefbewkkwnvlv.supabase.co wss://wjrlgcvyefbewkkwnvlv.supabase.co ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MzI0NkVBNEIzREY0MkUKUldRdTlEMUw2a1l5R0VsOFFURzdMU1FPdUE3OGF0bGNqaWlROHZUY3BPbHpYN3pJbi9CSXdML1IK",
      "endpoints": [
        "https://github.com/khalids01/badmintion-ledger/releases/latest/download/latest.json"
      ]
    }
  }
}
